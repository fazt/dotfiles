general {
        colors = true
        interval = 5
        color_good = "#5294e2"
        color_degraded = "#e5c07b"
        color_bad = "#e2554e"
        separator = "   "
}

order += "wireless wlp2s0"
order += "ethernet enp0s31f6"
order += "battery 0"
order += "volume master"
order += "memory"
order += "load"
order += "disk /"
order += "tztime local"

wireless wlp2s0 {
        format_up = "  %essid"
        format_down = "  ✗"
}

ethernet enp0s31f6 {
        format_up = "  %ip"
        format_down = ""
}

battery 0 {
        format = "%status %percentage"
        format_down = ""
        status_chr = ""
        status_bat = ""
        status_unk = ""
        status_full = ""
        low_threshold = 15
        threshold_type = percentage
        integer_battery_capacity = true
}

volume master {
        format = "  %volume"
        format_muted = "  %volume"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

memory {
        format = "  %percentage_used"
        threshold_degraded = "20%"
        format_degraded = "  %available"
}

load {
        format = "  %1min"
}

disk "/" {
        format = "  %avail"
}

tztime local {
        format = "  %a %d %b    %H:%M"
}
